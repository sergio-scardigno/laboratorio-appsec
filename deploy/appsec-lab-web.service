# Sustituye TU_USUARIO y /ruta/a/appsec-lab, y después instala como root:
#   cp deploy/appsec-lab-web.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now appsec-lab-web
[Unit]
Description=Laboratorio AppSec (web)
After=docker.service
Requires=docker.service

[Service]
User=TU_USUARIO
SupplementaryGroups=docker
WorkingDirectory=/ruta/a/appsec-lab
ExecStart=/ruta/a/appsec-lab/.venv/bin/lab web
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
