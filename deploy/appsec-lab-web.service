# Plantilla: la instala scripts/install-web-service.sh, que rellena el usuario y la ruta.
[Unit]
Description=Laboratorio AppSec (web)
After=docker.service
Requires=docker.service

[Service]
User=TU_USUARIO
SupplementaryGroups=docker
WorkingDirectory=/ruta/a/appsec-lab
ExecStart=/ruta/a/appsec-lab/.venv/bin/lab web --no-link
Restart=on-failure
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
